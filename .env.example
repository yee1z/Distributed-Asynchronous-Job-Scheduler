# Database
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@localhost:5432/scheduler

# Redis (dispatch queue)
REDIS_URL=redis://localhost:6379/0
STREAM_KEY=jobs:stream
CONSUMER_GROUP=workers

# Scheduler
SCHEDULER_POLL_INTERVAL_SEC=5
SCHEDULER_LOCK_KEY=42

# Worker
WORKER_CONCURRENCY=10
WORKER_BLOCK_MS=5000
# Reclaim messages whose owner has been idle longer than this (failover)
CLAIM_MIN_IDLE_MS=30000

# Logging
LOG_LEVEL=INFO
