# Database
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@localhost:5432/scheduler

# Redis (dispatch queue)
REDIS_URL=redis://localhost:6379/0
STREAM_KEY=jobs:stream
CONSUMER_GROUP=workers
DELAYED_SET_KEY=jobs:delayed

# Scheduler
SCHEDULER_POLL_INTERVAL_SEC=5
SCHEDULER_LOCK_KEY=42
# Re-enqueue runs stuck in 'queued' longer than this (lost-enqueue safety net)
ORPHAN_REQUEUE_AFTER_SEC=60

# Worker
WORKER_CONCURRENCY=10
WORKER_BLOCK_MS=5000
WORKER_READ_BATCH=20
# Reclaim messages whose owner has been idle longer than this (failover)
CLAIM_MIN_IDLE_MS=30000
# Upper bound for exponential retry backoff
RETRY_BACKOFF_MAX_SEC=3600

# Observability (Prometheus /metrics port for scheduler & worker)
METRICS_PORT=9100

# Logging
LOG_LEVEL=INFO
